+/*
+ * The scheduling token of compute job @seq (command +0x274). Bits 8-14
+ * index the queue's 128 scheduling entries (44 bytes each, at queue +0x0c),
+ * and the firmware asserts ("DAG: Non Sequential Stamp Updates") unless each
+ * command of a channel takes the entry after the previous one, mod 128. It
+ * starts again from the arriving command's entry only once the channel was
+ * idle, so jobs in flight need consecutive entries: a bare @seq gives every
+ * job below 256 entry 0, which crashed the T8011 firmware on the second of
+ * two queued jobs. The low byte stays @seq's: the completion stamp carries
+ * it, and the driver takes the job from it.
+ */
+static u32 sched_token(u32 seq)
+{
+	return (seq & 0x7f) << 8 | (seq & 0xff);
