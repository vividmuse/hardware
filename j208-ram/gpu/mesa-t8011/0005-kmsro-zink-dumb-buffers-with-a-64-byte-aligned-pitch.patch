From 794752517e9cb06c9ad4b6c8a42a828ebc5fa2e2 Mon Sep 17 00:00:00 2001
From: Leon <menghen@gmail.com>
Date: Thu, 12 Nov 2026 20:38:29 +0700
Subject: [PATCH] kmsro/zink: dumb buffers with a 64-byte-aligned row pitch

Apple G9P (PowerVR) render targets hold the row pitch in 64-byte units;
the J208's simpledrm dumb buffers are as wide as the 1668-pixel display
(6672 bytes), which the Vulkan driver refuses to import. Make Zink's
scanout dumb buffers wider so the pitch is a multiple of 64 bytes.

Generated-by: LLM
---
 .../winsys/kmsro/drm/kmsro_drm_winsys.c       | 25 ++++++++++++++++++-
 1 file changed, 24 insertions(+), 1 deletion(-)

diff --git a/src/gallium/winsys/kmsro/drm/kmsro_drm_winsys.c b/src/gallium/winsys/kmsro/drm/kmsro_drm_winsys.c
index 2ead5db..c383126 100644
--- a/src/gallium/winsys/kmsro/drm/kmsro_drm_winsys.c
+++ b/src/gallium/winsys/kmsro/drm/kmsro_drm_winsys.c
@@ -40,9 +40,32 @@
 #include "pipe-loader/pipe_loader.h"
 #include "renderonly/renderonly.h"
 #include "util/u_memory.h"
+#include "util/u_math.h"
+#include "util/format/u_format.h"
 
 #include "loader.h"
 
+#if defined(GALLIUM_ZINK)
+/*
+ * Zink's scanout resources: a dumb buffer whose row pitch is a multiple of 64
+ * bytes. Apple G9P (PowerVR) render targets hold the pitch in 64-byte units,
+ * and a dumb buffer as wide as the display may not be (the J208's simpledrm:
+ * 1668 pixels, 6672 bytes). The buffer is wider; the resource, and the
+ * framebuffer a compositor adds for it, keep their width.
+ */
+static struct renderonly_scanout *
+kmsro_zink_create_for_resource(struct pipe_resource *rsc, struct renderonly *ro,
+                               struct winsys_handle *out_handle)
+{
+   struct pipe_resource wide = *rsc;
+   const unsigned cpp = util_format_get_blocksize(rsc->format);
+
+   if (cpp && 64 % cpp == 0)
+      wide.width0 = align(rsc->width0, 64 / cpp);
+   return renderonly_create_kms_dumb_buffer_for_resource(&wide, ro, out_handle);
+}
+#endif
+
 static void kmsro_ro_destroy(struct renderonly *ro)
 {
    if (ro->gpu_fd >= 0)
@@ -133,7 +156,7 @@ struct pipe_screen *kmsro_drm_screen_create(int kms_fd,
 
 #if defined(GALLIUM_ZINK)
       if (!screen) {
-         ro->create_for_resource = renderonly_create_kms_dumb_buffer_for_resource;
+         ro->create_for_resource = kmsro_zink_create_for_resource;
          screen = zink_drm_create_screen_renderonly(ro->gpu_fd, ro, config);
       }
 #endif
